# Supabase (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# Clave pública: "anon" legacy o publishable nueva
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Opcional si tu proyecto usa el nombre nuevo de env en el dashboard
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=

# Solo servidor (ingesta RAG, operaciones privilegiadas). Nunca en el cliente.
SUPABASE_SERVICE_ROLE_KEY=

# IA — agente + embeddings
ANTHROPIC_API_KEY=
# Modelo Anthropic (opcional). Ej: claude-sonnet-4-20250514
# ANTHROPIC_MODEL=
OPENAI_API_KEY=

# openFDA (opcional, más cuota)
# OPENFDA_API_KEY=
