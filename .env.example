# Supabase (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# Origen público del sitio (obligatorio en producción para magic links). Debe coincidir con Auth → URL en Supabase o con `site_url` / `additional_redirect_urls` en `supabase/config.toml` antes de `supabase config push`.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Clave pública: "anon" legacy o publishable nueva
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Opcional si tu proyecto usa el nombre nuevo de env en el dashboard
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=

# Solo servidor (ingesta RAG, operaciones privilegiadas). Nunca en el cliente.
SUPABASE_SERVICE_ROLE_KEY=

# --- Vercel AI Gateway (recomendado hackathon / deploy en Vercel) ---
# `vercel link` → habilitá AI Gateway en el proyecto → `vercel env pull .env.local` (VERCEL_OIDC_TOKEN).
# O `AI_GATEWAY_API_KEY` para CI / fuera de Vercel.
# VERCEL_OIDC_TOKEN=
# AI_GATEWAY_API_KEY=
# AI_GATEWAY_CHAT_MODEL=anthropic/claude-sonnet-4-20250514

# --- Proveedores directos (solo si NO usás Gateway) ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
OPENAI_API_KEY=
# Si usás solo OpenAI (sin Gateway ni Anthropic) para el chat del MVP:
# OPENAI_CHAT_MODEL=gpt-4o-mini

# openFDA (opcional, más cuota)
# OPENFDA_API_KEY=
